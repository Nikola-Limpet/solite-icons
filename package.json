{
  "name": "solite-icons",
  "version": "0.2.0",
  "description": "Original rounded outline icons for Solite and React or SVG projects.",
  "keywords": [
    "icons",
    "outline",
    "react",
    "solite",
    "svg",
    "typescript"
  ],
  "homepage": "https://solite-icons.nikola33.dev",
  "bugs": "https://github.com/Nikola-Limpet/solite-icons/issues",
  "license": "MIT",
  "author": "Nikola-Limpet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikola-Limpet/solite-icons.git"
  },
  "files": [
    "dist",
    "svg",
    "sprite.svg",
    "manifest.json",
    "catalog",
    "README.md",
    "LICENSE",
    "docs/icons.md",
    "CHANGELOG.md",
    "assets/react-preview.png"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./dynamic": {
      "import": {
        "types": "./dist/types/dynamic.d.ts",
        "default": "./dist/esm/dynamic.js"
      },
      "require": {
        "types": "./dist/types-cjs/dynamic.d.ts",
        "default": "./dist/cjs/dynamic.js"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/types/data.d.ts",
        "default": "./dist/esm/data.js"
      },
      "require": {
        "types": "./dist/types-cjs/data.d.ts",
        "default": "./dist/cjs/data.js"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/types/icons/*.d.ts",
        "default": "./dist/esm/icons/*.js"
      },
      "require": {
        "types": "./dist/types-cjs/icons/*.d.ts",
        "default": "./dist/cjs/icons/*.js"
      }
    },
    "./svg/*.svg": "./svg/*.svg",
    "./sprite.svg": "./sprite.svg",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run build",
    "preview:render": "node scripts/render-preview.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "esbuild": "0.28.1",
    "oxfmt": "0.75.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
